---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={`${note.data.title} — Notes — Akshath Tiwari`} description={note.data.description} ogType="article">
  {note.data.immersive ? (
    <Content />
  ) : (
    <article class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
      <a href="/notes" class="text-sm text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300">&larr; All notes</a>
      <p class="mt-6 font-mono text-xs text-neutral-500">{formatDate(note.data.date)}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">{note.data.title}</h1>
      <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert">
        <Content />
      </div>
    </article>
  )}
</Layout>
